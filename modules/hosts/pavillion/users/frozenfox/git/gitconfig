[user]
  name = Fuyuka.nix
  email = fuyuka_nix@disroot.org
  signingkey = ~/.ssh/id_ed25519.pub

[core]
  compression = 9
  whitespace = error
  preloadindex = true

[gpg]
  format = ssh

[init]
  defaultBranch = main

[commit]
  gpgSign = true

[status]
  branch = true
  showStash = true
  showUntrackedFiles = all

[push]
  default = current
  followTags = true

[pull]
  default = current

[rebase]
  autoStash = true
  missingCommitsCheck = warn

[log]
  graphColors = blue,yellow,cyan,magenta,green,red

[pager]
  diff = diff-so-fancy | $PAGER

[interactive]
  diffFilter = diff-so-fancy --patch
  singlekey = true

[colors "diff"]
  meta = black bold
  frag = magenta
  context = white
  whitespace = yellow reverse
  old = red

[color "decorate"]
  HEAD = red
  branch = blue
  tag = yellow
  remoteBranch = magenta

[color "branch"]
  current = magenta
  local = default
  remote = yellow
  upstream = green
  plain = blue

[url "git@github.com:"]
  insteadOf = "gh:"

[url "ssh://git@codeberg.org/"]
  insteadOf = "cb:"
